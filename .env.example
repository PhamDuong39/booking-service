# Copy to .env and replace this development password before starting Compose.
BOOKING_DB_NAME=booking_db
BOOKING_DB_USER=booking
BOOKING_DB_PASSWORD=replace-with-a-local-password
BOOKING_DB_PORT=5432

# Core service ports (connections from the IDE/host).
BOOKING_REDIS_PORT=6379
BOOKING_KAFKA_PORT=9092
BOOKING_PROMETHEUS_PORT=9090
BOOKING_GRAFANA_PORT=3000

# Grafana initial login; replace the password in .env.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-local-grafana-password

# Optional workflow profile.
BOOKING_TEMPORAL_PORT=7233
BOOKING_TEMPORAL_UI_PORT=8233

# Optional identity profile; replace both passwords in .env.
BOOKING_KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-a-local-keycloak-password
KEYCLOAK_DB_PASSWORD=replace-with-a-local-keycloak-db-password
